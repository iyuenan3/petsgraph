{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petsgraph.dev/schemas/petpack/1.0/integrity.schema.json",
  "title": "PetPack 1.0 integrity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "algorithm", "files"],
  "properties": {
    "formatVersion": {"const": "1.0.0"},
    "algorithm": {"const": "sha256"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "mediaType", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "mediaType": {"type": "string", "minLength": 1, "maxLength": 120},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
