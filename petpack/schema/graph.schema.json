{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petsgraph.dev/schemas/petpack/1.0/graph.schema.json",
  "title": "PetPack 1.0 directed action graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "nodes", "edges"],
  "properties": {
    "formatVersion": {"const": "1.0.0"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "scene", "autonomousEligible"],
        "properties": {
          "id": {"$ref": "#/$defs/nodeId"},
          "role": {"enum": ["dwell", "gateway"]},
          "scene": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
          "loopClip": {"$ref": "#/$defs/clipId"},
          "autonomousEligible": {"type": "boolean"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "clip", "interruptPolicy"],
        "properties": {
          "id": {"$ref": "#/$defs/clipId"},
          "from": {"$ref": "#/$defs/nodeId"},
          "to": {"$ref": "#/$defs/nodeId"},
          "clip": {"$ref": "#/$defs/clipId"},
          "interruptPolicy": {"const": "finish-before-retarget"}
        }
      }
    }
  },
  "$defs": {
    "nodeId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 120},
    "clipId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 160}
  }
}
